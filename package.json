{
  "name": "beautybariq-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cp config/.env.dev .env && node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "deploy": "cp config/.env.prod .env && prisma generate && ./node_modules/.bin/serverless deploy --stage prod",
    "deploy:dev": "cp config/.env.lambda-dev .env && prisma generate && ./node_modules/.bin/serverless deploy --stage dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/client-ses": "^3.1129.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.2",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
