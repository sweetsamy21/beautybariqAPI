# Copy to config/.env.dev (local) or config/.env.prod (production) —
# `npm run dev` copies config/.env.dev to .env automatically.

DATABASE_URL=postgresql://user:password@host:5432/beautybariq
JWT_SECRET=replace-with-a-long-random-string
PORT=3011
NODE_ENV=development

# Used only by `npm run db:seed` to create the first admin login.
SEED_ADMIN_EMAIL=gina@beautybariq.com
SEED_ADMIN_PASSWORD=

# Only needed once the admin image-upload feature is wired up to real AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_ASSETS=beautybariq-media-prod
